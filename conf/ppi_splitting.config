/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Container, resources and publishing for the imported ppi-splitting pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow reads only the *root* project's nextflow.config, so when
    `subworkflows/external/ppi-splitting` is included, its own `process { }`
    block -- container, per-process resources, the `gurobi` label -- is never
    seen. Its `params { }` block is picked up separately, via
    `includeConfig 'subworkflows/external/ppi-splitting/conf/params.config'`
    in nextflow.config.

    The numbers below mirror that pipeline's nextflow.config as of submodule
    commit de188a9 and have to be kept in sync by hand. Two sources of truth is
    the cost of the split; extracting a `conf/process.config` upstream (the same
    move that produced `conf/params.config`) would remove it -- see
    PLAN_ppi_splitting_integration.md.

    The container tag and the submodule commit MUST move together: ppi-splitting
    bakes its `bin/` into the image, because Nextflow only puts the root
    project's `bin/` on PATH and the root project here is domainsplit.
----------------------------------------------------------------------------*/

process {

    // Every process of the imported pipeline, plus the three data-prep
    // processes DOMAINSPLIT calls directly for the union Pfam fetch (§5).
    withName: '.*:PPI_SPLITTING:.*|.*:(FETCH_DOMAIN_META|SUBSET_DOMAIN_DATA|GET_LENGTHS|EMPTY_GO_ANNOTATIONS)' {
        // NOTE: ppi-splitting's own `docker` profile still names `:0.1.0`, which
        // was never pushed. `:1.0.0` is the tag that exists.
        container  = 'docker.io/konstantinpelz/ppi-splitting:1.0.0'
        // Their own inline `publishDir` directives are overridden by this
        // selector, so restate one here: everything under one directory, keyed by
        // dataset row and then process. Both halves of that key matter -- keying
        // only by process would collapse the three rows' identically-named
        // outputs (`lengths.tsv`, `go_annotations.tsv`, ...) onto each other, and
        // domainsplit's default rule tokenizes on '_', which would additionally
        // merge SAMPLE_NEGATIVES_ILP and SAMPLE_NEGATIVES_DEGREE. `task.tag` is
        // the row id, which every process there sets from `meta.id`.
        publishDir = [
            path: {
                def row = task.tag ? "${task.tag}/" : ''
                "${params.outdir}/ppi_splitting/${row}${task.process.tokenize(':')[-1].toLowerCase()}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Gurobi WLS/floating licenses cap concurrent sessions; cap our own
    // concurrency to match and back off before retrying.
    withLabel: gurobi {
        maxForks     = 2
        beforeScript = { task.attempt > 1 ? "sleep ${task.attempt * 30}" : '' }
    }

    // One sequential pass over Pfam-A.fasta.gz (~6.3 GB compressed). Bounded by
    // transfer, not memory: nothing is buffered beyond a few reservoirs per
    // family. Runs once here, over the union of 3did and external-source
    // families, and its result is subset per dataset row afterwards.
    withName: '.*:FETCH_DOMAIN_META' {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }

    withName: '.*:RUN_BLAST' {
        cpus   = 64
        memory = '32 GB'
        time   = '12 h'
    }
    withName: '.*:RUN_KAHIP' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h  * task.attempt }
    }
    withName: '.*:CDHIT2D' {
        cpus   = 4
        memory = '8 GB'
        time   = '8 h'
    }
    withName: '.*:SOLVE_ILP' {
        cpus   = 10
        memory = '32 GB'
        time   = '4 h'
    }
    withName: '.*:SELECT_EXAMPLES' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withName: '.*:SAMPLE_NEGATIVES_ILP' {
        cpus   = 8
        memory = '16 GB'
        time   = { 6.h * task.attempt }
    }
    withName: '.*:SAMPLE_NEGATIVES_DEGREE' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withName: '.*:EXPAND_NEGATIVES' {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withName: '.*:EMBED_SEQUENCES' {
        cpus   = 4
        memory = '32 GB'
        time   = '12 h'
    }
    withName: '.*:TRAIN_CLASSIFIER' {
        memory = { 60.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withName: '.*:BIAS_ANALYSIS' {
        memory = { 60.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    // The bias report is the one ppi-splitting output domainsplit republishes
    // under its own name (§6): results/bias_analysis.html.
    withName: '.*:PPI_SPLITTING:.*:MULTIQC' {
        memory     = '16 GB'
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('multiqc_report.html') ? 'bias_analysis.html' : null },
        ]
    }
}
