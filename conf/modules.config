/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // The final domainsplit.sqlite3 is published via the workflow-level
    // `output { domainsplit_db { } }` block in `main.nf`. The intermediate
    // DBs flowing through the INSERT_* chain, the DDI pre-stages, and the
    // initial empty-schema DB all carry the same filename — letting the
    // default publishDir copy each of them under `insert/` / `init/` would
    // create stale duplicates and racy filename collisions. Disable
    // publishing for these intermediates explicitly.
    withName: 'INIT_DOMAINSPLIT_DB|INSERT_3DID|BUILD_SWISSPROT_PFAM_MAP|INSERT_DOMAIN_GO_TERMS|INSERT_PROTEIN_SEQUENCES|INSERT_PROTEIN_GO_TERMS|INSERT_PPI|INGEST_INSTANCES|INGEST_SAMPLED_NEGATIVES' {
        publishDir = [ enabled: false ]
    }

    // Reports on what left the database, or failed to enter it, on the way from
    // ppi-splitting's outputs to the published splits. Each carries a
    // domainsplit.sqlite3 intermediate alongside, which is not published.
    //   INGEST_SPLIT_MEMBERSHIP  unresolved_split_rows.tsv  -- split rows whose
    //       DDI or instance could not be resolved (a wiring error, not data).
    //   PRUNE_UNREPRESENTED_DDIS pruned_ddis.tsv            -- DDIs dropped
    //       because a family has no domain instance to represent it.
    //   BUILD_EXTERNAL_TEST      external_test_dropped.tsv  -- external DDIs
    //       with no instance pair whose parent proteins differ.
    withName: 'INGEST_SPLIT_MEMBERSHIP|PRUNE_UNREPRESENTED_DDIS|BUILD_EXTERNAL_TEST' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                (filename.equals('versions.yml') || filename.endsWith('.sqlite3')) ? null : filename
            }
        ]
    }

    // The per-split databases are published by the workflow-level
    // `output { split_db { } }` block in `main.nf`, which is what puts them
    // under databases/<method>/<split>.sqlite3.
    withName: 'SUBSET_SPLIT_DB' {
        publishDir = [ enabled: false ]
    }

    // INSERT_EXTERNAL_SOURCES' domainsplit.sqlite3 is an intermediate (published
    // only via the workflow-level output block); its source_conflicts.tsv --
    // every domain pair dropped because two external sources disagreed on
    // whether it interacts -- IS published.
    withName: 'INSERT_EXTERNAL_SOURCES' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                (filename.equals('versions.yml') || filename.endsWith('.sqlite3')) ? null : filename
            }
        ]
    }

    // The candidate network is an input to ppi-splitting's `ilp_candidates`
    // sampler; the UniProt->Pfam mapping beside it is a fetch diagnostic.
    withName: 'BUILD_CANDIDATE_NETWORK' {
        publishDir = [
            path: { "${params.outdir}/candidate_network" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Normalized external-source TSVs, published as the provenance record of
    // what each source contributed before the merge/drop rules ran.
    withName: 'PARSE_SINGLE_DOMAIN_PPI|PARSE_PPIDM|PARSE_NEGATOME' {
        publishDir = [
            path: { "${params.outdir}/external_ddis" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // The two handoff files: families.txt is the union FETCH_DOMAIN_META resolves
    // instances for, split_ddis.csv is the exact positive set every ppi-splitting
    // dataset row is given. Neither is republished downstream, and both are the
    // provenance record for what entered the splits, so publish them together.
    withName: 'EXPORT_UNION_FAMILIES|EXPORT_SPLIT_DDIS' {
        publishDir = [
            path: { "${params.outdir}/ppi_splitting/inputs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Embedding chunk concurrency. The DaiSyBio QoS caps concurrent GPU jobs per
    // account, so this is the local mirror of that cap; it also stops parallel
    // tasks from each pulling the gated ~12 GB of weights when
    // `--embedding_hf_cache_dir` is not pointed at a shared directory. The fan-out
    // is models x shards, so the default 3 x 4 = 12 tasks queue behind this.
    //
    // Publishing is off: a per-shard chunk is a pure intermediate, and the default
    // publishDir at the top of this block would land them all in
    // `${params.outdir}/generate/`.
    withName: '.*:GENERATE_DOMAIN_EMBEDDINGS_CHUNK' {
        maxForks = 4
        publishDir = [ enabled: false ]
        // Exit 1 on top of base.config's signal/OOM set, because the first thing
        // this task does is pull multi-GB gated weights from HuggingFace, and a
        // broken transfer surfaces as a plain Python traceback
        // (requests ChunkedEncodingError / IncompleteRead) -> exit 1, which
        // base.config classifies as `finish` and which kills the whole run an
        // hour into a GPU fan-out. Retrying is cheap once
        // `--embedding_hf_cache_dir` points at a shared cache: the partial
        // download is resumed, not restarted. A genuine bug in run_embeddings.py
        // also exits 1 and so costs two extra attempts -- accepted, because the
        // network failure is the common one and it is transient.
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 1 + (175..177)) ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    // The published embeddings, one HDF5 per model, keyed {domain_id}/{instance_id}.
    // An explicit path is load-bearing: the default publishDir tokenizes the
    // process name, so without this rule the files would land in
    // `${params.outdir}/export/`.
    withName: '.*:EXPORT_DOMAIN_EMBEDDINGS' {
        publishDir = [
            path: { "${params.outdir}/embeddings" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
