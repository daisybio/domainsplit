/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A *real* run over 85 Pfam families. Every process executes; nothing is
    stubbed. Use as follows:

        nextflow run daisybio/domainsplit -profile test,docker --outdir <OUTDIR>

    Two things this needs that a laptop does not have, which is why this profile
    is a cluster profile and not a CI one:

      * a GPU and an `HF_TOKEN` -- `generate_domain_embeddings` runs the real gated
        ESM3/ESMC weights (and downloads ProtT5), so add `-profile test,docker,gpu`;
      * the ppi-splitting container, `docker.io/konstantinpelz/ppi-splitting:1.0.0`.

    Everything else is offline. The fixtures under `tests/data/` are cut from the
    real sources by `tests/bin/make_test_fixtures.py` (see tests/data/README.md),
    including a pre-populated Pfam download cache and the gene→Pfam mapping that
    keeps BUILD_CANDIDATE_NETWORK off the UniProt API.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Real run over 85 Pfam families, offline except the embedding weights'

    // Required file params (no defaults in nextflow.config)
    hippie_tsv                = "${projectDir}/tests/data/hippie.tsv"
    ppidm_tsv                 = "${projectDir}/tests/data/ppidm.tsv"
    negative_ppi_parquet      = "${projectDir}/tests/data/negative_ppi.parquet"
    // Pre-computed gene → UniProt → Pfam mapping: no UniProt REST calls.
    negative_ppi_gene_mapping = "${projectDir}/tests/data/gene_pfam_mapping.json"

    // Source URLs -> local fixtures
    url_3did                      = "${projectDir}/tests/data/3did.sql.gz"
    url_negatome                  = "${projectDir}/tests/data/negatome.txt"
    url_uniprot_swissprot_pfam    = "${projectDir}/tests/data/swissprot_pfam.tsv"
    url_uniprot_id_mapping        = "${projectDir}/tests/data/uniprot_id_mapping.dat.gz"
    url_uniprot_go_terms          = "${projectDir}/tests/data/uniprot_go_terms.tsv.gz"
    url_uniprot_sequences         = "${projectDir}/tests/data/uniprot_sequences.fasta.gz"
    url_string                    = "${projectDir}/tests/data/string.txt.gz"
    url_pfam2go                   = "${projectDir}/tests/data/pfam2go.txt"

    // ppi-splitting's Pfam inputs. `pfam_release` only has to be *pinned* — it
    // labels the cache directory and skips the one download a warm cache cannot
    // (Pfam.version) — so it must match the directory name under interpro_cache.
    pfam_fasta     = "${projectDir}/tests/data/pfam/Pfam-A.fasta.gz"
    pfam_clans     = "${projectDir}/tests/data/pfam/Pfam-A.clans.tsv.gz"
    pfam_release   = '38.0'
    interpro_cache = "${projectDir}/tests/data/pfam/interpro_cache"

    // Small enough to finish, large enough to be a real split: 2 instance pairs
    // per DDI drawn from a pool of 6 instances per family.
    ddi_examples_target      = 2
    ddi_examples_pool_factor = 3

    // 85 families is still far below the default cluster counts, and the ILP
    // time limits exist to bound a real run, not a fixture one.
    ilp_kahip_k        = 10
    ilp_max_sec        = 300
    neg_ilp_time_limit = 300
    ddi_select_max_sec = 60
    // Coarse KaHIP clusters split three ways (train/val/test) force lumpy PPI
    // allocation -- the production 0.05 epsilon was infeasible at fixture scale
    // (SOLVE_ILP: "Model is infeasible or unbounded" on the minimal_leakage row).
    // Left loose even after growing the fixture to tests/data/README.md's 85
    // families / 333 DDIs, since it's untested at that size.
    ilp_epsilon = 0.4

    // `ilp_candidates` is on here, matching the pipeline default. It was off
    // while the fixture was too small, and that was a real constraint rather
    // than caution: candidate pairs are consumed *per split*, ppi-splitting's
    // partitions are family-exclusive, so a pair survives only if both its
    // families landed in the same split -- survival is quadratic in that split's
    // share, and SAMPLE_NEGATIVES_ILP hard-errors ("need N negatives but only M
    // candidate pairs are available") instead of degrading.
    //
    // The fixture is now 85 families / 333 3did DDIs / 319 unique positive pairs,
    // and its candidate_network.csv is the complete non-positive pair set (3336
    // pairs = 3655 possible - 319 positives, which BUILD_CANDIDATE_NETWORK
    // subtracts itself). Measured over that pair set, 20 000 uniform family draws
    // per fraction:
    //
    //   split fraction   families   candidate pairs (p5)   positives (p95)   P(cand < pos)
    //   0.10 (val)              8                     23                13         0.02 %
    //   0.15                   13                     67                24         0 %
    //   0.20 (test)            17                    118                35         0 %
    //   0.70 (train)           59                   1573               197         0 %
    //
    // The 0.1 val split now covers itself with room to spare. Growing the fixture
    // was preferred over raising `split_val_fraction`, because the real ILP
    // partition is lumpier than the uniform draw these numbers assume and only
    // growth helps the lumpy case -- and 85 rather than the ~60 that first clears
    // the bar, because at 70 families the same measurement gives 0.49 % for the
    // 0.1 split, 24x worse, for only 21 % fewer DDIs.
    ppi_splitting_multi_negset = true
}
