/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    daisybio/domainsplit Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Every parameter of the imported ppi-splitting pipeline. Included *before* our
// own params block, because a later assignment wins and the two sides share
// names on purpose (`outdir`, `seed`, `ddi_examples_*`). Nextflow reads only the
// root project's config, so without this line all ~40 of them are undefined.
// Its process/container settings live in conf/ppi_splitting.config instead.
includeConfig 'subworkflows/external/ppi-splitting/conf/params.config'

// Global default params, used in configs
params {

    // Source database URLs
    url_3did                      = 'https://3did.irbbarcelona.org/download/current/3did.sql.gz'

    // The UniProt flat files that ARE the run's protein universe, comma-separated.
    // `null` derives them from `instance_tier` (see the derivation block below
    // the params block). One pass over them feeds six consumers: the GO-term TSV,
    // the accession->Pfam TSV, the protein FASTA, the STRING-id map (all four out
    // of PARSE_SWISSPROT) and FETCH_DOMAIN_META, which needs a sequence and a
    // taxon for every accession Pfam-A.regions might name -- regions carries
    // coordinates only.
    //
    // Static FTP, not `rest.uniprot.org`: the REST stream queries these replaced
    // are throttled to ~4 KB/s per connection, so an all-reviewed GO query
    // (~19 MB) never finishes -- the server drops the connection around 30 min and
    // Nextflow reports `Premature EOF`.
    //
    // **Swiss-Prot must come first.** An accession promoted from TrEMBL to
    // Swiss-Prot between releases exists in both files, and the reviewed record is
    // the one to keep; both parsers take the first writer.
    uniprot_dat_urls = null

    // NCBI taxon ids kept while parsing the flat files; empty string keeps every
    // species. `null` derives it from `instance_tier` ('9606' for `human_*`, ''
    // for `all_species_*`). Set it explicitly only to narrow *further*, e.g.
    // '9606,10090' together with `all_species_reviewed` for a human+mouse run.
    swissprot_taxon_ids = null

    url_negatome = 'https://mips.helmholtz-muenchen.de/proj/ppi/negatome/combined_pfam.txt'
    //url_negatome = "${projectDir}/assets/ppi_detect_negatome.tsv"

    // STRING links. `null` is the normal setting: FETCH_STRING_LINKS derives the
    // taxon list from the STRING ids of the proteins actually in the database and
    // downloads STRING's per-organism links file for each, so every species the
    // universe admits gets enriched. Set this to a path or URL to pin ONE explicit
    // links file instead and skip the fetch entirely -- which is what `-profile
    // test` does to stay offline.
    //
    // Not the all-organism monolith: protein.links.v12.0.txt.gz is 138 GB and
    // >99 % of it is species this run has never heard of.
    url_string = null
    // STRING release the per-organism URL template is built from:
    // https://stringdb-downloads.org/download/protein.links.v<rel>/<taxid>.protein.links.v<rel>.txt.gz
    string_release = '12.0'
    // Skip a taxon contributing fewer than this many proteins, so one stray
    // protein does not cost a 50 MB download. 1 = fetch for every taxon present.
    string_min_proteins_per_taxon = 1

    url_pfam2go = 'https://current.geneontology.org/ontology/external2go/pfam2go'

    // Domain-embedding models, sharding and inference knobs.
    //
    // Only the *cut domain sequence* is embedded, one pooled vector per domain
    // instance, and the result is published as
    // `<outdir>/embeddings/<model>_domain_embeddings.h5` rather than stored in
    // the database. Per-residue protein embeddings are retired: protein context
    // correlates with the interaction partner, so slicing one smuggles protein
    // identity into a split that was partitioned on families.
    //
    // `embedding_models_domainbench` is also the skip switch -- set it empty to
    // produce no embeddings at all. The awkward suffix is deliberate:
    // ppi-splitting already owns a param called `embedding_model` (see
    // `ignoreParams` below), and two near-identical valid names for unrelated
    // knobs is a silent-typo trap.
    //
    // The domain FASTA is split into `embedding_shards` shards and each
    // (model, shard) pair runs as one GPU task, concurrency capped by `maxForks`
    // in conf/modules.config. `embedding_batch_size_<model>` is the *initial*
    // batch size; OOM halves it in-process and retries. `embedding_max_len` drops
    // sequences longer than this (quadratic-attention long tail).
    // `embedding_hf_cache_dir` is a shared NFS directory used as HF_HOME so
    // parallel chunk tasks all read the gated ESM3 / ESMC weights from one
    // pre-populated cache instead of each re-downloading ~12 GB.
    // Cluster-specific, so there is no useful default: pass
    // `--embedding_hf_cache_dir /nfs/scratch/hf_cache`, or set it in the
    // institutional config you run with (-c). '' uses a per-task cache.
    embedding_models_domainbench = 'esm3,esmc,prott5'
    embedding_shards             = 4
    embedding_max_len            = 4096
    embedding_batch_size_esm3    = 32
    embedding_batch_size_esmc    = 32
    embedding_batch_size_prott5  = 32
    embedding_prott5_model       = 'Rostlab/prot_t5_xl_half_uniref50-enc'
    // Abort the task when no GPU is visible instead of running inference on CPU.
    // CPU inference is not a slow success: one 1.4B model load per task OOM-killed
    // five concurrent tasks on a shared node. Set false only to deliberately
    // accept CPU inference on a tiny input.
    embedding_require_gpu        = true
    embedding_hf_cache_dir       = ''

    // Y2H/MS PPI screen parquet (columns: gene_name_bait, gene_name_prey,
    // n_tested, ...) used to build the *candidate network*: BUILD_CANDIDATE_NETWORK
    // filters rows by `n_tested`, maps genes to UniProt then Pfam (via the UniProt
    // REST API), and emits every Pfam pair the screen tested without finding an
    // interaction, restricted to families appearing in a 3did DDI. ppi-splitting
    // draws its `ilp_candidates` negatives from that pool. Required input (no
    // default; must be supplied per run).
    negative_ppi_parquet         = null
    negative_ppi_min_n_tested    = 5

    // Optional `gene_pfam_mapping.json` from an earlier run of
    // BUILD_CANDIDATE_NETWORK. Supplied, the gene -> UniProt -> Pfam lookup is
    // read from it and the UniProt REST API is never called — which is the only
    // way `-profile test` runs offline, and which also stops a re-run from
    // re-querying tens of thousands of gene names. Genes the file does not cover
    // count as unmapped, so a stale mapping shrinks the pool rather than failing.
    negative_ppi_gene_mapping    = null

    // Reviewed-human UniProt -> Pfam stream used to detect single-domain
    // proteins (accession, entry name, gene names, Pfam xrefs).

    // Positive DDIs inferred from HIPPIE PPIs between two single-domain proteins.
    // Required input (no default). Rows are kept when the HIPPIE confidence
    // score (column 5) is >= hippie_min_score.
    hippie_tsv                   = null
    hippie_min_score             = 0.63

    // Positive DDIs from PPIDM predictions (predicted_ddi_ppi.tsv with columns
    // domain_1, domain_2, class). Class is kept as source 'PPIDM_<Class>'.
    // Required input (no default).
    ppidm_tsv                    = null
    ppidm_classes                = 'Bronze,Silver,Gold'

    // Master random seed. Passed to ppi-splitting and used by every sampling
    // step on this side, so a run is reproducible from this one number.
    seed                         = 42

    // How many concrete instance pairs represent one DDI. Both are passed
    // through to ppi-splitting (same names, same meaning) and used by
    // BUILD_EXTERNAL_TEST, so the external test set is sized like the splits.
    // `ddi_examples_pool_factor` bounds the work rather than the result: at most
    // target * factor instances are drawn per family before pairs are formed.
    ddi_examples_target          = 5
    ddi_examples_pool_factor     = 5

    // The run's protein universe. THE knob: it is the sole decider of which
    // UniProt flat files are downloaded (`uniprot_dat_urls`), which taxa survive
    // parsing (`swissprot_taxon_ids`) and which strata FETCH_DOMAIN_META may
    // sample (`instance_tiers`, the upstream vocabulary). The other three are
    // derived below and exist only for narrowing.
    //
    // Four alternatives, not a ladder -- exactly one per run:
    //
    //   human_reviewed (default)       human Swiss-Prot                 ~20 k
    //   all_species_reviewed           + non-human Swiss-Prot          ~573 k
    //   human_any_review_status        + human TrEMBL                  ~200 k
    //   all_species_any_review_status  + all TrEMBL  -- NOT IMPLEMENTED, see
    //                                  https://github.com/daisybio/domainsplit/issues/4
    //
    // Upstream fills its strata in the order human_reviewed -> other_reviewed ->
    // human_unreviewed -> other_unreviewed: reviewed outranks human, so a family
    // with no human Swiss-Prot member prefers a curated non-human sequence over an
    // auto-annotated human one. Lower strata fill *freely*, not as a top-up: a
    // family with 3 human Swiss-Prot regions under `all_species_reviewed` keeps
    // those 3 and fills the remaining pool slots from non-human reviewed proteins.
    // So widening the universe reshapes the instance pool of families that were
    // never dropped, not only the ones that were.
    //
    // Families left with no eligible instance keep none, and their DDIs are
    // dropped by PRUNE_UNREPRESENTED_DDIS.
    instance_tier                = 'human_reviewed'

    // Pfam-A.regions.tsv.gz is FETCH_DOMAIN_META's instance source: every Pfam
    // region of every reference-proteome protein, with no redundancy reduction.
    // Deliberately NOT Pfam-A.fasta, which Pfam publishes 90 % non-redundant --
    // that dropped the human member of every well-conserved family and cost a
    // 12,769-family human request 10,566 of them. Set `pfam_regions` to a local
    // copy to skip the ~4.7 GB transfer; `cache_dir` makes repeat runs a stat and
    // a read.
    url_pfam_regions             = 'https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.regions.tsv.gz'
    pfam_regions                 = null

    // ONE cache root for every download this pipeline caches: ppi-splitting's
    // Pfam/UniProt files under `pfam-<release>/` (it is handed this path as its
    // `interpro_cache`, which stays as a legacy alias) and the per-organism STRING
    // links under `string/`. **Must be an absolute path on a filesystem every
    // compute node shares** -- it is resolved to one, but node-local scratch gives
    // every task its own cold cache. A convenience only: a cold run produces
    // identical output.
    cache_dir                    = null

    // Route the imported pipeline through DATA_PREP_DDI: its interaction files
    // hold Pfam family accessions, not UniProt ones, and it splits domain
    // instances rather than whole chains. Overrides ppi-splitting's own default.
    ddi_mode                     = true

    // ppi-splitting defaults to Gurobi for both ILPs and stages a gurobi.lic as
    // a required file input.
    ilp_solver                   = 'GUROBI'
    gurobi_license               = 'gurobi.lic'

    // Split fractions for the three ppi-splitting dataset rows. `random` and
    // `minimal_leakage` use all three; the `external_test` row has no internal
    // test set (its test split is BUILD_EXTERNAL_TEST's unseen external DDIs),
    // so it runs with test = 0 and train = 1 - split_val_fraction.
    split_train_fraction         = 0.7
    split_val_fraction           = 0.1
    split_test_fraction          = 0.2

    // Ask ppi-splitting for both ILP negative sets per split -- plain `ilp` plus
    // `ilp_candidates`, the same sampler restricted to the candidate network --
    // which is what turns 3 method directories into 5 and 11 split databases
    // into 18. The comma-separated `negative_sampling_method` fan-out this needs
    // is in the pinned submodule (`parseNegsets`), so the default is now on.
    //
    // Kept as a param rather than deleted for one reason: ppi-splitting's
    // `--split_only` refuses to run unless `negative_sampling_method` is exactly
    // "ilp", so a `--split_only` debug run must be launched with
    // `--ppi_splitting_multi_negset false`.
    ppi_splitting_multi_negset   = true

    // Boilerplate options
    input                        = null
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    DERIVED FROM `instance_tier`
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Three values follow from one. Here rather than in the workflow because
    FETCH_DOMAIN_META (in the read-only submodule) reads `params.instance_tiers`
    straight out of its own script block, so it has to be a param -- and
    `params` is read-only by the time a workflow body runs.

    A CLI `--instance_tier X` IS visible here: Nextflow merges command-line params
    into the binding before parsing the config, so these expressions see the
    override, not the default above. Verified, not assumed. Each of the three
    guards on `!= null` (not truthiness) so an explicit empty
    `--swissprot_taxon_ids` from a -params-file survives.

    An unrecognised `instance_tier` resolves to '' here and is rejected by the
    guard block in workflows/domainsplit.nf, which is also where
    `all_species_any_review_status` hard-fails.
----------------------------------------------------------------------------*/

// Our four-valued knob -> ppi-splitting's stratum names. THE ONLY place the two
// vocabularies meet: upstream has no notion of `human_any_review_status`, and
// this pipeline has no notion of `other_reviewed`.
params.instance_tiers = [
    human_reviewed         : 'human_reviewed',
    all_species_reviewed   : 'human_reviewed,other_reviewed',
    human_any_review_status: 'human_reviewed,human_unreviewed',
    // all_species_any_review_status: unimplemented; the workflow guard fails on it.
].get(params.instance_tier.toString(), '')

// `human_reviewed` takes the 114 MB taxonomic-division file rather than the
// 667 MB complete one -- same result after the 9606 filter, six times less
// transfer. Swiss-Prot first in every list: see `uniprot_dat_urls` above.
params.uniprot_dat_urls = params.uniprot_dat_urls != null ? params.uniprot_dat_urls : [
    human_reviewed         : 'https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/taxonomic_divisions/uniprot_sprot_human.dat.gz',
    all_species_reviewed   : 'https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/complete/uniprot_sprot.dat.gz',
    human_any_review_status: 'https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/taxonomic_divisions/uniprot_sprot_human.dat.gz,https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/taxonomic_divisions/uniprot_trembl_human.dat.gz',
].get(params.instance_tier.toString(), '')

params.swissprot_taxon_ids = params.swissprot_taxon_ids != null
    ? params.swissprot_taxon_ids
    : (params.instance_tier.toString().startsWith('human_') ? '9606' : '')

// One cache root, two consumers. `interpro_cache` is ppi-splitting's own param
// name and is kept as a legacy alias: passing either works, `cache_dir` wins.
params.cache_dir      = params.cache_dir != null ? params.cache_dir : params.interpro_cache
params.interpro_cache = params.cache_dir

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        // -e HOME=/tmp: the micromamba-based images run `micromamba run` as their
        // entrypoint, which needs a writable HOME for its proc dir. With `-u uid:gid`
        // the container has no home (HOME=/), so point it at world-writable /tmp.
        docker.runOptions       = '-u $(id -u):$(id -g) -e HOME=/tmp'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) -e HOME=/tmp --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        // The ppi-splitting image is large enough that the 20 min default
        // expires mid-pull. Its own singularity/apptainer profiles raise this,
        // and we do not include those (they bring a container tag with them), so
        // restate it here.
        singularity.pullTimeout = '2 h'
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.pullTimeout   = '2 h'
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) -e HOME=/tmp --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load daisybio/domainsplit custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load daisybio/domainsplit custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/domainsplit.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
    // The native CUDACachingAllocator (both expandable_segments and max_split_size_mb
    // paths) calls nvmlInit_v2_ on first big alloc and asserts on failure. Singularity
    // --nv on this cluster cannot init NVML (libnvidia-ml version mismatch with host
    // driver — see "Can't initialize NVML" warning in ESM logs), so the assertion
    // fires mid-forward in ESM3. The cudaMallocAsync backend bypasses the C++
    // caching allocator entirely and does not touch NVML.
    PYTORCH_CUDA_ALLOC_CONF = "backend:cudaMallocAsync"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    // A run that aborts renders the report twice; without this the second
    // render dies on FileAlreadyExistsException and buries the real error.
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    // A run that aborts renders the report twice; without this the second
    // render dies on FileAlreadyExistsException and buries the real error.
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    // A run that aborts renders the report twice; without this the second
    // render dies on FileAlreadyExistsException and buries the real error.
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    // A run that aborts renders the report twice; without this the second
    // render dies on FileAlreadyExistsException and buries the real error.
    overwrite = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'daisybio/domainsplit'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Konstantin Pelz',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Christian Romberg',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Chiara Thomas',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/daisybio/domainsplit'
    description     = """A nextflow pipeline to split domain-domain interaction data into train, validation, and test while reducing data leakage and bias."""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.2'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
    // NOTE: `lenientMode` does NOT coerce a CLI String into a numeric or boolean
    // param -- it only widens the other direction, letting an integer satisfy a
    // string type. Tested against nf-schema 2.5.1 and 2.7.2: with it on, an
    // override still fails with "Value is [string] but should be [integer]".
    // The fix is the typed `params { }` block at the top of main.nf, which makes
    // Nextflow coerce before validation runs. Kept here only because it is
    // harmless; no param in this schema relies on it.
    lenientMode = true
    // Every param of the imported ppi-splitting pipeline that this pipeline does
    // not itself expose. They arrive through
    // `includeConfig 'subworkflows/external/ppi-splitting/conf/params.config'`,
    // so nf-schema sees them and would flag each one as an unrecognised input.
    // Listing them here rather than copying them into nextflow_schema.json keeps
    // their defaults in exactly one place -- their params.config -- so the two
    // pipelines cannot drift. Regenerate this list when the submodule is bumped:
    // it is the set of keys in their params.config minus the ones our schema
    // declares (currently seed, ddi_mode, ddi_examples_target,
    // ddi_examples_pool_factor, outdir and the nf-core boilerplate).
    ignoreParams = [
        "samplesheet",
        "split_only",
        "embedding_model",
        "cdhit_identity",
        "cdhit_wordsize",
        "heatmap_max_per_split",
        "split_method",
        "edge_weight",
        "kahip_seed",
        "kahip_k",
        "kahip_preconfiguration",
        "ilp_kahip_k",
        "train_split",
        "val_split",
        "test_split",
        "ilp_epsilon",
        "ilp_max_sec",
        "ilp_solver",
        "gurobi_license",
        "negative_sampling_method",
        "neg_ilp_lambda_degree",
        "neg_ilp_lambda_taxon_pair",
        "neg_ilp_lambda_self_loop",
        "neg_ilp_lambda_jaccard",
        "neg_ilp_solver",
        "neg_ilp_time_limit",
        "neg_ilp_mip_gap",
        "ddi_select_max_sec",
        "ddi_max_ilp_candidates",
        "ddi_lambda_diversity",
        "ddi_shortlist_factor",
        "ddi_select_verbose",
        "ddi_candidate_factor",
        "interpro_cache",
        "pfam_clans",
        "uniprot_dat",
        "pfam_release",
        // Derived, never set by hand: the derivation block above translates our
        // four-valued `instance_tier` into ppi-splitting's stratum-name list.
        "instance_tiers",
    ]
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

// Container, resources and publishing for the imported ppi-splitting processes.
// Last, so its selectors win over modules.config's default publishDir rule.
includeConfig 'conf/ppi_splitting.config'
