// Minimal harness config for tests/contracts/*.nf. Not a pipeline profile: it
// only has to satisfy ppi-splitting's own params and the plugin it imports.
includeConfig '../../subworkflows/external/ppi-splitting/conf/params.config'

params {
    outdir           = 'results_contracts'
    bad_split_method = 'kahip'
    drop_partition   = false
    // SPLIT_POSITIVES resolves this with file() at DAG-construction time, so it
    // has to exist before the validation under test is ever reached.
    gurobi_license   = 'tests/contracts/gurobi.lic.placeholder'
}

plugins { id 'nf-schema@2.5.1' }
validation { defaultIgnoreParams = ['genomes'] }
