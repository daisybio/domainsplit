# Copy this file to .env and fill in your values.
# The .env file is gitignored and must never be committed.
#
# Usage with Nextflow (recommended):
#   nextflow secrets set HF_TOKEN <your_token>
#   or export HF_TOKEN before running the pipeline.
#
# Usage on a SLURM cluster:
#   Add `export HF_TOKEN=...` to your job script or ~/.bashrc.

# HuggingFace access token — required for downloading the gated ESM3 / ESMC
# weights used by GENERATE_DOMAIN_EMBEDDINGS_CHUNK. ProtT5, the third embedding
# model, is ungated and needs no token, so a run with
# `--embedding_models_domainbench prott5` does not need this set.
# Obtain at: https://huggingface.co/settings/tokens
# Access request: https://huggingface.co/EvolutionaryScale/esm3-sm-open-v1
HF_TOKEN=
