FROM mambaorg/micromamba:2.10.0

# Build/tag as konstantinpelz/domainsplit-gpu:2.0.0
# Build context is docker/:
#   docker build -f docker/Dockerfile.gpu -t konstantinpelz/domainsplit-gpu:2.0.0 docker/
# Packages and pins (conda + the single pip block) live in docker/env/gpu.yml.
# Covers the GPU process in daisybio/domainsplit pipeline:
#   - GENERATE_DOMAIN_EMBEDDINGS_CHUNK (torch + esm SDK + transformers/ProtT5
#     + h5py + biopython + tqdm)
#
# CUDA 13.0 (torch 2.11.0+cu130 wheel; its nvidia-* deps bring the CUDA runtime
# and cuDNN, so no conda cuda/cudnn packages). Host driver must support CUDA >= 13.0.
LABEL org.opencontainers.image.source="https://github.com/daisybio/domainsplit"
LABEL org.opencontainers.image.version="2.0.0"
LABEL org.opencontainers.image.description="domainsplit GPU container (CUDA 13.0, torch 2.11, esm SDK, transformers/ProtT5, biopython, h5py)"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

USER root
RUN apt-get update && apt-get install -y --no-install-recommends procps \
 && rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER

ENV ENV_NAME=gpu
ENV PATH=/opt/conda/envs/${ENV_NAME}/bin:$PATH
ENV CONDA_PREFIX=/opt/conda/envs/${ENV_NAME}
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=100

ENV NVIDIA_TF32_OVERRIDE=0
# The native CUDACachingAllocator (both expandable_segments and max_split_size_mb
# paths) calls nvmlInit_v2_ on first big alloc and asserts on failure. Singularity
# --nv on this cluster cannot init NVML (libnvidia-ml.so version mismatch with
# host driver — "Can't initialize NVML" warning), so the assertion fires inside
# ESM3 forward. The cudaMallocAsync backend bypasses the C++ caching allocator
# entirely and does not touch NVML.
ENV PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync

COPY --chown=$MAMBA_USER:$MAMBA_USER env/gpu.yml /tmp/env.yml
RUN micromamba create -y -n ${ENV_NAME} -f /tmp/env.yml \
 && micromamba clean --all --yes \
 && rm /tmp/env.yml

ENTRYPOINT ["micromamba", "run", "-n", "gpu"]
CMD ["python"]
