FROM mambaorg/micromamba:2.10.0

# Build/tag as konstantinpelz/domainsplit-general:2.0.0
# Build context is docker/:
#   docker build -f docker/Dockerfile.general -t konstantinpelz/domainsplit-general:2.0.0 docker/
# Packages and pins live in docker/env/general.yml, not here.
# Covers all CPU processes in daisybio/domainsplit pipeline:
#   - DOWNLOAD_3DID, INSERT_3DID (gawk + gzip + bin/mysql2sqlite, sqlite3 stdlib)
#   - INIT_DOMAINSPLIT_DB (sqlite3 stdlib)
#   - PARSE_SINGLE_DOMAIN_PPI, PARSE_PPIDM, PARSE_NEGATOME, BUILD_SWISSPROT_PFAM_MAP,
#     INSERT_EXTERNAL_SOURCES (pandas, sqlite3 stdlib)
#   - BUILD_CANDIDATE_NETWORK (pandas + pyarrow + requests)
#   - EXPORT_UNION_FAMILIES, EXPORT_SPLIT_DDIS, EXPORT_SPLIT_INPUTS (sqlite3 stdlib)
#   - INGEST_INSTANCES, INGEST_SPLIT_MEMBERSHIP, INGEST_SAMPLED_NEGATIVES (biopython, sqlite3 stdlib)
#   - INSERT_DOMAIN_GO_TERMS, INSERT_PROTEIN_SEQUENCES, INSERT_PROTEIN_GO_TERMS,
#     INSERT_PPI (pandas, biopython, tqdm, sqlite3 stdlib)
#   - PRUNE_UNREPRESENTED_DDIS, BUILD_EXTERNAL_TEST, SUBSET_SPLIT_DB (sqlite3 stdlib)
#   - SHARD_FASTA (biopython)
#   - EXPORT_DOMAIN_EMBEDDINGS (h5py, numpy, sqlite3 stdlib)
LABEL org.opencontainers.image.source="https://github.com/daisybio/domainsplit"
LABEL org.opencontainers.image.version="2.0.0"
LABEL org.opencontainers.image.description="domainsplit CPU container (pandas, pyarrow, numpy, h5py, biopython, tqdm, requests, matplotlib, sqlite, wget, gawk)"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# procps gives `ps` for Nextflow metrics collection
USER root
RUN apt-get update && apt-get install -y --no-install-recommends procps \
 && rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER

ENV ENV_NAME=general
ENV PATH=/opt/conda/envs/${ENV_NAME}/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

COPY --chown=$MAMBA_USER:$MAMBA_USER env/general.yml /tmp/env.yml
RUN micromamba create -y -n ${ENV_NAME} -f /tmp/env.yml \
 && micromamba clean --all --yes \
 && rm /tmp/env.yml

ENTRYPOINT ["micromamba", "run", "-n", "general"]
CMD ["python"]
